{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minshot",
  "version": "0.4.1",
  "identifier": "com.minshot.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "minshot",
        "url": "index.html",
        "visible": false,
        "skipTaskbar": false,
        "backgroundColor": "#0b0b0e",
        "width": 248,
        "height": 118,
        "resizable": true,
        "minWidth": 240,
        "minHeight": 100,
        "maximizable": false,
        "minimizable": true
      },
      {
        "label": "overlay",
        "title": "minshot overlay",
        "url": "overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": true,
        "fullscreen": false,
        "shadow": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/minshot/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "marrrkkk",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFMjE4M0JCMjM0RjA2NkEKUldScUJrOGp1NE1oenVuT1pYVTQxNmJZck4yWmVLdmI5ZUJSb1l3ekJkSXVHdUovdzBWbUVOTU0K",
      "endpoints": [
        "https://github.com/marrrkkk/minshot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
