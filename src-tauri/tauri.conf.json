{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minshot",
  "version": "0.1.0",
  "identifier": "com.minshot.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "minshot",
        "url": "index.html",
        "visible": true,
        "skipTaskbar": false,
        "backgroundColor": "#09090b",
        "width": 380,
        "height": 340,
        "resizable": false,
        "maximizable": false,
        "minimizable": true
      },
      {
        "label": "overlay",
        "title": "minshot overlay",
        "url": "src/overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": true,
        "fullscreen": false,
        "shadow": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
